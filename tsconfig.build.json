{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "sourceMap": false,
        "jsx": "preserve",
        "noEmit": false,
        "noCheck": true,
        "allowImportingTsExtensions": false,
        "declarationMap": true,
        "rootDir": "src",
        "outDir": "dist"
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ],
    "exclude": [
        "dist",
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/**/*.spec.ts",
        "src/**/*.spec.tsx"
    ]
}