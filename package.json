{
  "name": "opencode-sidebar-modern-context",
  "version": "1.0.1",
  "description": "OpenCode TUI sidebar plugin for real-time context window usage, tokens, cache, cost, and tool call metrics.",
  "type": "module",
  "main": "./tui.ts",
  "module": "./tui.ts",
  "exports": {
    ".": "./tui.ts",
    "./tui": "./tui.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-jsx.mjs",
    "build:jsx": "node scripts/build-jsx.mjs",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/build-jsx.mjs\"",
    "test": "bun test/test.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test",
    "update": "git pull && bun run check && bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opentui",
    "tui",
    "context-window",
    "tokens",
    "metrics"
  ],
  "author": "Gamflaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MomoPi-Dark/opencode-sidebar-modern-context"
  },
  "dependencies": {
    "@opencode/client": "2.0.28",
    "@opencode/plugin": "2.0.27",
    "@opencode/theme": "2.0.27",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@resvg/resvg-js": "^2.6.2",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsc-watch": "^7.2.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.17"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "private": true
}
